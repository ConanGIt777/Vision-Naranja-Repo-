@page
@model VisionNaranja.Pages.Admin.Productos.CreateModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Nuevo Producto/Servicio";
}

<h1 class="h3 mb-4">Nuevo Producto/Servicio</h1>

<div class="admin-form-card">
    <form method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Emprendimiento</label>
                <select name="EmprendimientoId" class="form-select" required asp-items="@(new SelectList(Model.Emprendimientos, "EmprendimientoId", "NombreMarca"))">
                    <option value="">-- Selecciona --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Categoría</label>
                <select name="CategoriaId" class="form-select" required asp-items="@(new SelectList(Model.Categorias, "CategoriaId", "Nombre"))">
                    <option value="">-- Selecciona --</option>
                </select>
            </div>
            <div class="col-md-8">
                <label class="form-label">Nombre</label>
                <input type="text" name="Nombre" class="form-control" required maxlength="200" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <select name="TipoOferta" class="form-select" required>
                    <option value="1">Producto</option>
                    <option value="2">Servicio</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea name="Descripcion" class="form-control" rows="3" maxlength="500"></textarea>
            </div>
            <div class="col-md-4">
                <label class="form-label">Precio (opcional)</label>
                <input type="number" name="Precio" class="form-control" step="0.01" min="0" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input type="checkbox" name="Disponible" class="form-check-input" value="true" checked />
                    <label class="form-check-label">Disponible</label>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger mt-3">@Model.Error</div>
        }

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-naranja">Guardar y continuar a fotos</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>