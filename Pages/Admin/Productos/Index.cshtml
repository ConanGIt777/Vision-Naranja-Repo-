@page
@model VisionNaranja.Pages.Admin.Productos.IndexModel
@{
    ViewData["Title"] = "Productos y Servicios";
}

<div class="admin-toolbar">
    <h1 class="h3 mb-0">Productos y Servicios</h1>
    <a asp-page="Create" class="btn btn-naranja"><i class="bi bi-plus-lg"></i> Nuevo Producto/Servicio</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive admin-table">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Portada</th>
                <th>Nombre</th>
                <th>Emprendimiento</th>
                <th>Categoría</th>
                <th>Tipo</th>
                <th>Precio</th>
                <th>Disponible</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Productos)
            {
                <tr>
                    <td>
                        @if (p.PortadaMediaId.HasValue)
                        {
                            <img src="/Media/Producto/@p.PortadaMediaId" class="admin-avatar-thumb" style="border-radius:8px;" alt="" />
                        }
                        else
                        {
                            <div class="admin-avatar-thumb d-flex align-items-center justify-content-center" style="border-radius:8px;">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </td>
                    <td>@p.Nombre</td>
                    <td>@p.Emprendimiento?.NombreMarca</td>
                    <td>@p.Categoria?.Nombre</td>
                    <td>@p.TipoOferta</td>
                    <td>@(p.Precio.HasValue ? p.Precio.Value.ToString("C") : "—")</td>
                    <td>
                        @if (p.Disponible)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@p.ProductoServicioId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@p.ProductoServicioId" class="d-inline"
                              onsubmit="return confirm('¿Eliminar &quot;@p.Nombre&quot;? Se borrarán también sus fotos.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>