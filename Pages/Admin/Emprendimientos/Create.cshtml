@page
@model VisionNaranja.Pages.Admin.Emprendimientos.CreateModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Nuevo Emprendimiento";
}

<h1 class="h3 mb-4">Nuevo Emprendimiento</h1>

<div class="admin-form-card" style="max-width:720px;">
    <form method="post" enctype="multipart/form-data">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Logo del emprendimiento (opcional, puedes subirlo después)</label>
                <input type="file" name="Logo" class="form-control" accept="image/*" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Emprendedor</label>
                <select name="EmprendedorId" class="form-select" required asp-items="@(new SelectList(Model.Emprendedores, "EmprendedorId", "NombreCompleto"))">
                    <option value="">-- Selecciona --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ciudad</label>
                <select name="CiudadId" class="form-select" required asp-items="@(new SelectList(Model.Ciudades, "CiudadId", "Nombre"))">
                    <option value="">-- Selecciona --</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">Nombre de marca</label>
                <input type="text" name="NombreMarca" class="form-control" required maxlength="150" />
            </div>
            <div class="col-12">
                <label class="form-label">Descripción</label>
                <textarea name="Descripcion" class="form-control" rows="3" required maxlength="500"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">Sitio web</label>
                <input type="text" name="SitioWeb" class="form-control" maxlength="255" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Medios de pago</label>
                <input type="text" name="MediosDePago" class="form-control" maxlength="255" placeholder="Efectivo, Transferencia..." />
            </div>
            <div class="col-md-6">
                <label class="form-label">Zona de despacho</label>
                <input type="text" name="ZonaDeDespacho" class="form-control" maxlength="255" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Tiempo de entrega</label>
                <input type="text" name="TiempoDeEntrega" class="form-control" maxlength="100" />
            </div>
            <div class="col-12">
                <label class="form-label">Certificaciones (separadas por coma)</label>
                <input type="text" name="Certificaciones" class="form-control" maxlength="255" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox" name="Activo" class="form-check-input" value="true" checked />
                    <label class="form-check-label">Activo</label>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger mt-3">@Model.Error</div>
        }

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-naranja">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>