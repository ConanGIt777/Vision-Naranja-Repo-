@page
@model VisionNaranja.Pages.Admin.Emprendimientos.IndexModel
@{
    ViewData["Title"] = "Emprendimientos";
}

<div class="admin-toolbar">
    <h1 class="h3 mb-0">Emprendimientos</h1>
    <a asp-page="Create" class="btn btn-naranja"><i class="bi bi-plus-lg"></i> Nuevo Emprendimiento</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive admin-table">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Marca</th>
                <th>Emprendedor</th>
                <th>Ciudad</th>
                <th>Productos</th>
                <th>Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Emprendimientos)
            {
                <tr>
                    <td>@e.NombreMarca</td>
                    <td>@e.Emprendedor?.NombreCompleto</td>
                    <td>@e.Ciudad?.Nombre</td>
                    <td>@e.ProductosServicios.Count</td>
                    <td>
                        @if (e.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@e.EmprendimientoId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@e.EmprendimientoId" class="d-inline"
                              onsubmit="return confirm('¿Eliminar &quot;@e.NombreMarca&quot;? Esta acción no se puede deshacer.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>