@page
@model VisionNaranja.Pages.Admin.Emprendedores.IndexModel
@{
    ViewData["Title"] = "Emprendedores";
}

<div class="admin-toolbar">
    <h1 class="h3 mb-0">Emprendedores</h1>
    <a asp-page="Create" class="btn btn-naranja"><i class="bi bi-plus-lg"></i> Nuevo Emprendedor</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive admin-table">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Foto</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Emprendimientos</th>
                <th>Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Emprendedores)
            {
                <tr>
                    <td>
                        @if (e.FotoPerfil != null)
                        {
                            <img src="/Media/Emprendedor/@e.EmprendedorId" class="admin-avatar-thumb" alt="" />
                        }
                        else
                        {
                            <div class="admin-avatar-thumb d-flex align-items-center justify-content-center">
                                <i class="bi bi-person"></i>
                            </div>
                        }
                    </td>
                    <td>@e.NombreCompleto</td>
                    <td>@e.CorreoElectronico</td>
                    <td>@(e.Telefono ?? "—")</td>
                    <td>@e.Emprendimientos.Count</td>
                    <td>
                        @if (e.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@e.EmprendedorId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@e.EmprendedorId" class="d-inline"
                              onsubmit="return confirm('¿Eliminar a @e.NombreCompleto? Esta acción no se puede deshacer.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>