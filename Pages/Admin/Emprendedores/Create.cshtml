@page
@model VisionNaranja.Pages.Admin.Emprendedores.CreateModel
@{
    ViewData["Title"] = "Nuevo Emprendedor";
}

<h1 class="h3 mb-4">Nuevo Emprendedor</h1>

<div class="admin-form-card">
    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Nombre completo</label>
            <input type="text" name="NombreCompleto" class="form-control" required maxlength="150" />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <input type="email" name="CorreoElectronico" class="form-control" required maxlength="150" />
        </div>
        <div class="mb-3">
            <label class="form-label">Teléfono (formato WhatsApp, ej: 593987654321)</label>
            <input type="text" name="Telefono" class="form-control" maxlength="20" />
        </div>
        <div class="mb-3">
            <label class="form-label">Foto de perfil</label>
            <input type="file" name="Foto" class="form-control" accept="image/*" />
        </div>
        <div class="form-check mb-3">
            <input type="checkbox" name="Activo" class="form-check-input" value="true" checked />
            <label class="form-check-label">Activo</label>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-naranja">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>