<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Visión Naranja</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <span class="vn-logo">V</span> Admin
            </div>
            <nav class="admin-nav">
                <a asp-page="/Admin/Emprendedores/Index" class="admin-nav-link">
                    <i class="bi bi-people"></i> Emprendedores
                </a>
                <a asp-page="/Admin/Emprendimientos/Index" class="admin-nav-link">
                    <i class="bi bi-shop"></i> Emprendimientos
                </a>
                <a asp-page="/Admin/Productos/Index" class="admin-nav-link">
                    <i class="bi bi-box-seam"></i> Productos/Servicios
                </a>
            </nav>
            <a asp-page="/Admin/Logout" class="admin-nav-link admin-logout">
                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
            </a>
        </aside>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>